# Build outputs
bin/
obj/
*.user
publish/

# Data & secrets (never commit live keys)
data/
secrets/

# Env files: real values live in Infisical (docs/secrets-infisical.md).
# .env.example stays tracked as the placeholder template.
.env
.env.*
!.env.example

# Rider/VS
.idea/
.vs/
*.suo

# OS
Thumbs.db
Desktop.ini

# Preview artifacts
*.html
*.png
# Test runners and coverage collection
TestResults/
coverage/

# Session logs
.wraplog.txt
__pycache__/
bridge/_sidecar*.log

# Local tool installs and release-verification scratch
.tools/
bin-verify/

# Portable MT5 terminal copied into the repo tree (never enters git history:
# its terminal64.exe / MetaEditor64.exe exceed GitHub's 100 MB per-file limit)
mt5_portable/

# Desktop-tool runtime state (session dirs, never source)
.freebuff/
