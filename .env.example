# Placeholder template for the Infisical import and for local runs that have not
# migrated yet. THIS FILE IS TRACKED IN GIT — every value below is a placeholder.
# Put real values in Infisical (or in your own untracked .env), never here.
# See docs/secrets-infisical.md.

# --- LLM endpoint for the Journal Analyst / Risk Narrator ---------------
# Read by JournalAnalystService, RiskNarratorService and scripts/ai_alpha.
# Defaults (when unset) are the local Ollama endpoint and qwen3:0.6b.
TF_LLM_BASE_URL=http://127.0.0.1:11434/v1
TF_LLM_MODEL=qwen3:0.6b
# Only needed when TF_LLM_BASE_URL points at a hosted provider; Ollama ignores it.
TF_LLM_API_KEY=

# --- Webhooks (CI scripts today; paste-to-post credentials) -------------
# Flake tracker posts test-flake summaries; the metrics digest posts cycle telemetry.
FLAKE_WEBHOOK_URL=
METRICS_WEBHOOK_URL=

# --- Data directory -----------------------------------------------------
# Optional override; unset means %APPDATA%\tf\data. The local gate sets this
# to a scratch directory so test teardowns cannot delete the real session data.
# TF_DATA_DIR=
