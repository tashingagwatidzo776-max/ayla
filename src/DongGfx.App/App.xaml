<Application x:Class="DongGfx.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DongGfx.App.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
            <infra:CountToVisibilityConverter x:Key="CountToVisibility" />
            <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <infra:WebhookSeverityToBrushConverter x:Key="WebhookSeverityToBrush" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>