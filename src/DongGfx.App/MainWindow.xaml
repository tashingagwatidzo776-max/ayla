<Window x:Class="DongGfx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DongGfx.App.Controls"
        xmlns:infra="clr-namespace:DongGfx.App.Infrastructure"
        Title="DON G FX — MT5 Forex &amp; CFD Trader"
        Icon="assets/logo.ico"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="0,0,0,0">

        <!-- ═══════════ Header ═══════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="assets/logo.png" Height="28" Width="28" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="DON G FX" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="  MT5 Forex &amp; CFD Trader · Trade | Analyze | Profit"
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dashboard.IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Dashboard.StatusText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <TextBlock Text="{Binding Dashboard.BalanceText}" FontFamily="Consolas" FontWeight="SemiBold" />
                    </Border>
                    <Button Margin="8,0,0,0" Padding="8,4"
                            Content="ℹ About" Click="OnAbout"
                            ToolTip="Version and build identity of this binary" />
                    <Button Margin="8,0,0,0" Padding="8,4"
                            ToolTip="Minimize to tray — app keeps running in background">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Content" Value="🔽 Tray" />
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Tabs ═══════════ -->
        <TabControl Margin="0,0,0,0">
            <TabItem Header="Dashboard">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />   <!-- portfolio summary -->
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Status row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel>
                            <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Symbol: " Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Dashboard.SymbolText}" FontFamily="Consolas" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Brain: " Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TerminalVm.BrainStateText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusPill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Mode: " Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SettingsVm.ModeLabel}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <Button Grid.Column="1"
                                Command="{Binding Dashboard.ToggleKillSwitchCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                    <Setter Property="Content" Value="☠ KILL SWITCH" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dashboard.IsKillSwitchEngaged}" Value="True">
                                            <Setter Property="Content" Value="☠ ENGAGED — CLICK TO RESET" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Portfolio summary: combined growth P&amp;L + latched risk rails -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Portfolio P&amp;L: " Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Dashboard.CombinedGrowthPnlText}" FontFamily="Consolas" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="FX realised, today" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Dashboard.RiskRailAlerts}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#33FF5C5C" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Chart -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <controls:TickChartControl x:Name="Chart"
                                                   LineBrush="{StaticResource AccentBrush}"
                                                   ShowIndicators="True" />
                    </Border>

                    <!-- Footer -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Dashboard.LastPriceText}"
                                   FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Dashboard.TickCountText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,16" MaxWidth="720" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- 0 Account -->
                            <RowDefinition Height="Auto" />  <!-- 1 API token -->
                            <RowDefinition Height="Auto" />  <!-- 2 App ID -->
                            <RowDefinition Height="Auto" />  <!-- 3 Demo -->
                            <RowDefinition Height="Auto" />  <!-- 4 MARKET -->
                            <RowDefinition Height="Auto" />  <!-- 5 Symbol -->
                            <RowDefinition Height="Auto" />  <!-- 6 Currency -->
                            <RowDefinition Height="Auto" />  <!-- 7 Duration -->
                            <RowDefinition Height="Auto" />  <!-- 8 Stake -->
                            <RowDefinition Height="Auto" />  <!-- 9 AUTONOMY -->
                            <RowDefinition Height="Auto" />  <!-- 10 Autonomy -->
                            <RowDefinition Height="Auto" />  <!-- 11 Decision interval -->
                            <RowDefinition Height="Auto" />  <!-- 12 LLM BRAIN -->
                            <RowDefinition Height="Auto" />  <!-- 13 Base URL -->
                            <RowDefinition Height="Auto" />  <!-- 14 Model -->
                            <RowDefinition Height="Auto" />  <!-- 15 API key -->
                            <RowDefinition Height="Auto" />  <!-- 16 MARKET HOURS -->
                            <RowDefinition Height="Auto" />  <!-- 17 Respect hours -->
                            <RowDefinition Height="Auto" />  <!-- 18 Overlaps only -->
                            <RowDefinition Height="Auto" />  <!-- 19 WEBHOOKS -->
                            <RowDefinition Height="Auto" />  <!-- 20 Webhook URL -->
                            <RowDefinition Height="Auto" />  <!-- 21 URL validation -->
                            <RowDefinition Height="Auto" />  <!-- 22 Platform + test button -->
                            <RowDefinition Height="Auto" />  <!-- 23 Events -->
                            <RowDefinition Height="Auto" />  <!-- 24 LOGGING -->
                            <RowDefinition Height="Auto" />  <!-- 25 Log level -->
                            <RowDefinition Height="Auto" />  <!-- 26 Monitoring title -->
                            <RowDefinition Height="Auto" />  <!-- 27 Digest toggle -->
                            <RowDefinition Height="Auto" />  <!-- 28 Digest interval -->
                            <RowDefinition Height="Auto" />  <!-- 29 Unlock staleness -->
                            <RowDefinition Height="Auto" />  <!-- 30 Actions -->
                            <RowDefinition Height="Auto" />  <!-- 31 Status -->
                            <RowDefinition Height="Auto" />  <!-- 32 FX BRAIN section -->
                            <RowDefinition Height="Auto" />  <!-- 33 FX portfolio fields -->
                            <RowDefinition Height="Auto" />  <!-- 34 Portfolio max lots -->
                            <RowDefinition Height="Auto" />  <!-- 35 News blackout -->
                            <RowDefinition Height="Auto" />  <!-- 36 MT5 terminal path -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="ACCOUNT" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Demo account" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                                  Content="Demo (real money requires explicit opt-in + risk guardrails)"
                                  IsChecked="{Binding SettingsVm.IsDemo}" />

                        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="AUTONOMY" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Autonomy" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,0,0,10"
                                  Content="Let the brain place trades (guardrails enforced)"
                                  IsChecked="{Binding SettingsVm.AutonomyEnabled}" />
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="MT5 max lots" Style="{StaticResource FieldLabel}" Margin="16,0,8,0"
                                   VerticalAlignment="Center"
                                   ToolTip="Ceiling on a single MT5 bridge order (lots). 0 disables MT5 order placement entirely." />
                        <TextBox Grid.Row="10" Grid.Column="3" Width="120" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.Mt5MaxLots, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="10" Grid.Column="4" Text="MT5 daily loss cap" Style="{StaticResource FieldLabel}" Margin="16,0,8,0"
                                   VerticalAlignment="Center"
                                   ToolTip="The FX brain stops (and returns to paper) when session P/L drops this far below the session-start balance. 0 disables." />
                        <TextBox Grid.Row="10" Grid.Column="5" Width="120" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.Mt5DailyLossCap, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="10" Grid.Column="6" Text="MT5 equity floor" Style="{StaticResource FieldLabel}" Margin="16,0,8,0"
                                   VerticalAlignment="Center"
                                   ToolTip="Absolute equity floor: the FX brain stops when MT5 equity falls below this. 0 = disabled." />
                        <TextBox Grid.Row="10" Grid.Column="6" Grid.ColumnSpan="1" Width="120" HorizontalAlignment="Right" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.Mt5EquityFloor, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="19" Grid.ColumnSpan="2" Text="WEBHOOKS" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <TextBlock Grid.Row="20" Grid.Column="0" Text="Webhook URL" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="20" Grid.Column="1" Margin="0,0,0,4"
                                 Text="{Binding SettingsVm.WebhookUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="21" Grid.Column="1" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="{Binding SettingsVm.WebhookValidationMessage}"
                                   Foreground="{Binding SettingsVm.WebhookUrlSeverity, Converter={StaticResource WebhookSeverityToBrush}}"
                                   Visibility="{Binding SettingsVm.WebhookValidationMessage.Length, Converter={StaticResource CountToVisibility}}"
                                   ToolTip="Live validation: https required (localhost excepted) and the host must match the selected platform format" />
                        <TextBlock Grid.Row="22" Grid.Column="0" Text="Platform" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="22" Grid.Column="1" Margin="0,0,10,10"
                                  Content="Discord (uncheck for Slack)"
                                  IsChecked="{Binding SettingsVm.IsDiscordWebhook}" />
                        <Button Grid.Row="22" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,0,10"
                                Style="{StaticResource GhostButton}"
                                Content="Send test message" Command="{Binding SettingsVm.TestWebhookCommand}"
                                ToolTip="Posts a small test message to the URL in the field above so a bad webhook is caught here instead of silently failing on a real trade event (result appears next to Save)" />

                        <TextBlock Grid.Row="23" Grid.Column="0" Text="Events" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="23" Grid.Column="1" Margin="0,0,0,10">
                            <CheckBox Content="Trade settlements" IsChecked="{Binding SettingsVm.WebhookOnTrade}" Margin="0,0,0,4" />
                            <CheckBox Content="Milestones (target/floor)" IsChecked="{Binding SettingsVm.WebhookOnMilestone}" Margin="0,0,0,4" />
                            <CheckBox Content="Circuit breaker events" IsChecked="{Binding SettingsVm.WebhookOnCircuitBreaker}" />
                        </StackPanel>

                        <TextBlock Grid.Row="24" Grid.ColumnSpan="2" Text="LOGGING" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <TextBlock Grid.Row="25" Grid.Column="0" Text="Log level" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="25" Grid.Column="1" Margin="0,0,0,10" Width="120" HorizontalAlignment="Left"
                                  ItemsSource="{Binding SettingsVm.LogLevels}" SelectedIndex="{Binding SettingsVm.LogLevel}" />

                        <TextBlock Grid.Row="26" Grid.ColumnSpan="2" Text="MONITORING" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <CheckBox Grid.Row="27" Grid.Column="1" Margin="0,0,0,10"
                                  Content="Post cycle-telemetry digest to webhook (latency/errors)"
                                  IsChecked="{Binding SettingsVm.MetricsDigestEnabled}"
                                  ToolTip="Off silences the periodic metrics digest only — trade settlement notifications are unaffected" />
                        <TextBlock Grid.Row="28" Grid.Column="0" Text="Digest interval (h)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="28" Grid.Column="1" Margin="0,0,0,10" Width="120" HorizontalAlignment="Left"
                                 Text="{Binding SettingsVm.MetricsDigestIntervalHours, UpdateSourceTrigger=PropertyChanged, TargetNullValue=6}"
                                 ToolTip="Hours between cycle-telemetry digest posts (1–168, default 6). Takes effect on the next app start." />

                        <TextBlock Grid.Row="29" Grid.Column="0" Text="Unlock staleness (h)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="29" Grid.Column="1" Margin="0,0,0,10" Width="120" HorizontalAlignment="Left"
                                 Text="{Binding SettingsVm.ArmStalenessHours, UpdateSourceTrigger=PropertyChanged, TargetNullValue=4}"
                                 ToolTip="Toast + webhook when a real-money session unlock has been armed this long (1–72, default 4). Live on save; 0 disables the alert." />

                        <StackPanel Grid.Row="30" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Save settings" Command="{Binding SettingsVm.SaveCommand}" Margin="0,0,10,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="31" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                   Text="{Binding SettingsVm.StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="32" Grid.ColumnSpan="2" Text="FX BRAIN (FOREX)" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <TextBlock Grid.Row="33" Grid.Column="0" Text="Symbols (CSV)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="33" Grid.Column="1" Width="220" Margin="0,0,16,10" HorizontalAlignment="Left"
                                 Text="{Binding SettingsVm.FxSymbols, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="One engine per symbol — comma-separated MT5 symbols the brain runs (paper first)." />
                        <TextBlock Grid.Row="34" Grid.Column="0" Text="Portfolio max lots" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                   ToolTip="Total open lots across ALL FX-brain symbols at order time. 0 disables the portfolio veto." />
                        <TextBox Grid.Row="34" Grid.Column="1" Width="80" Margin="0,0,16,10" HorizontalAlignment="Left"
                                 Text="{Binding SettingsVm.FxPortfolioMaxLots, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="35" Grid.Column="0" Text="News blackout (min)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                   ToolTip="Minutes before/after each high-impact calendar event (data
ews-calendar.json) where the brain refuses new orders. 0 disables." />
                        <TextBox Grid.Row="35" Grid.Column="1" Width="80" Margin="0,0,16,10" HorizontalAlignment="Left"
                                 Text="{Binding SettingsVm.NewsBlackoutMinutes, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="36" Grid.Column="0" Text="MT5 terminal path" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                   ToolTip="terminal64.exe the bridge attaches to. Empty = auto-discover. Honored by the watchdog, sidecar and startup profile." />
                        <TextBox Grid.Row="36" Grid.Column="1" Width="220" Margin="0,0,16,10" HorizontalAlignment="Left"
                                 Text="{Binding SettingsVm.Mt5TerminalPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                 ToolTip="C:/Program Files/MetaTrader 5 Terminal/terminal64.exe — leave empty to auto-discover." />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ TERMINAL — our own MT5-style trading desk ════════════════ -->
            <TabItem Header="Terminal">
                <Grid Margin="12" DataContext="{Binding TerminalVm}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- account bar -->
                        <RowDefinition Height="*" />
                        <!-- main content -->
                    </Grid.RowDefinitions>

                    <!-- ── Account bar ── -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="TERMINAL" Style="{StaticResource SectionTitle}"
                                           VerticalAlignment="Center" Margin="0,0,18,0" />
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding AccountText}" FontWeight="SemiBold" />
                                </Border>
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding ConnectionText}" />
                                </Border>
                                <Border Style="{StaticResource StatusPill}">
                                    <TextBlock Text="{Binding BalanceText}" Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold" />
                                </Border>
                                <!-- build freshness: running build vs latest GitHub release -->
                                <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0"
                                        ToolTip="The running build vs the latest published release. A stale build misses the latest safety fixes — update from the Update tab.">
                                    <TextBlock Text="{Binding BuildBadge}" FontFamily="Consolas" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <!-- ── DON G FX FX BRAIN ── -->
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0"
                                        ToolTip="The forex brain: regime detection + momentum/mean-reversion families on MT5. Paper mode journals signals only; go-live needs the paper soak first.">
                                    <TextBlock Text="{Binding FxBadge}" FontWeight="Bold" FontSize="11" />
                                </Border>
                                <Button Content="FX BRAIN ON/OFF" Command="{Binding ToggleFxBrainCommand}"
                                        Margin="0,0,6,0" />
                                <Button Content="GO LIVE" Command="{Binding FxGoLiveCommand}" Margin="0,0,6,0" />
                                <Button Content="PAPER" Style="{StaticResource GhostButton}"
                                        Command="{Binding FxGoPaperCommand}" Margin="0,0,6,0" />
                                <Button Content="RE-ARM" Style="{StaticResource GhostButton}"
                                        Command="{Binding FxReArmCommand}" Margin="0,0,12,0"
                                        ToolTip="After a supervisor loss stop: clear the halt and re-anchor the session loss baseline to the live MT5 balance." />
                                <!-- ── THE BRAIN SWITCH ── -->
                                <Button Content="🧠 BRAIN: ON" Command="{Binding TurnBrainOnCommand}"
                                        Margin="0,0,6,0" />
                                <Button Content="🧠 BRAIN: OFF" Style="{StaticResource GhostButton}"
                                        Command="{Binding TurnBrainOffCommand}" Margin="0,0,12,0" />
                                <Button Content="⏹ EMERGENCY STOP" Style="{StaticResource DangerButton}"
                                        Command="{Binding EmergencyStopCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>                    <!-- ── MT5-style workspace ── -->
                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <!-- Status bar (bottom) -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}"
                                Padding="10,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ConnectionText}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding BalanceText}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding Mt5AccountText}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding FxStatusText}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding DomSourceText}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding CandleSourceText}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding Timeframes}" SelectedItem="{Binding SelectedTimeframe}"
                                          Width="70" Margin="12,0,0,0" FontSize="11"
                                          ToolTip="Chart timeframe (M1…MN1)" />
                                <TextBlock Text="{Binding RsiLast, StringFormat=RSI 0.0, TargetNullValue=''}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" />
                                <TextBlock Text="{Binding IndicatorText}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Toolbox (bottom dock) -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0"
                                MaxHeight="260">
                            <TabControl Background="Transparent" BorderThickness="0">
                                <TabItem Header="Trade">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="SL" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                                            <TextBox Text="{Binding ModifySl, UpdateSourceTrigger=PropertyChanged}" Width="80" Padding="4,3"
                                                     ToolTip="New stop loss (empty = keep)" />
                                            <TextBlock Text="TP" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11" />
                                            <TextBox Text="{Binding ModifyTp, UpdateSourceTrigger=PropertyChanged}" Width="80" Padding="4,3"
                                                     ToolTip="New take profit (empty = keep)" />
                                            <Button Content="Modify selected" Command="{Binding ModifyMt5PositionCommand}"
                                                    CommandParameter="{Binding SelectedItem.Ticket, ElementName=TradeGrid}"
                                                    Style="{StaticResource GhostButton}" Padding="10,3" Margin="8,0,0,0"
                                                    ToolTip="Apply SL/TP to the selected MT5 position" />
                                            <TextBlock Text="Lots" VerticalAlignment="Center" Margin="16,0,4,0" FontSize="11" />
                                            <TextBox Text="{Binding PartialCloseLots, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="4,3"
                                                     ToolTip="Lots to close partially (e.g. 0.1)" />
                                            <Button Content="Partial close" Command="{Binding PartialCloseMt5PositionCommand}"
                                                    CommandParameter="{Binding SelectedItem.Ticket, ElementName=TradeGrid}"
                                                    Style="{StaticResource GhostButton}" Padding="10,3" Margin="8,0,0,0"
                                                    ToolTip="Close part of the selected MT5 position" />
                                            <TextBlock Text="{Binding Mt5OrderStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                       FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                        <DataGrid x:Name="TradeGrid" ItemsSource="{Binding TradeRows}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                              Background="Transparent" RowBackground="Transparent"
                                              BorderThickness="0" FontFamily="Consolas" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Ticket" Binding="{Binding Ticket}" Width="130" />
                                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="100" />
                                            <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="80" />
                                            <DataGridTextColumn Header="Vol" Binding="{Binding Volume, StringFormat=0.###}" Width="60" />
                                            <DataGridTextColumn Header="Entry" Binding="{Binding Entry, StringFormat=0.#####}" Width="90" />
                                            <DataGridTextColumn Header="Now" Binding="{Binding Current, StringFormat=0.#####}" Width="90" />
                                            <DataGridTextColumn Header="P/L" Binding="{Binding Profit, StringFormat=+0.##;-0.##;0}" Width="70" />
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="60" />
                                            <DataGridTemplateColumn Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="✕" Padding="6,0" FontSize="11"
                                                                Visibility="{Binding Mt5CloseVisibility}"
                                                                Command="{Binding DataContext.TerminalVm.CloseMt5PositionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Mt5Ticket}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Orders">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding OrderStatus}" FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}" Margin="4,4,0,0" />
                                        <DataGrid ItemsSource="{Binding OrderRows}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                                  Background="Transparent" RowBackground="Transparent"
                                                  BorderThickness="0" FontFamily="Consolas" FontSize="11">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Ticket" Binding="{Binding Ticket}" Width="120" />
                                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="110" />
                                                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="60" />
                                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="70" />
                                                <DataGridTextColumn Header="Vol" Binding="{Binding Volume, StringFormat=0.###}" Width="60" />
                                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=0.#####}" Width="90" />
                                                <DataGridTextColumn Header="SL" Binding="{Binding Sl, StringFormat=0.#####}" Width="80" />
                                                <DataGridTextColumn Header="TP" Binding="{Binding Tp, StringFormat=0.#####}" Width="80" />
                                                <DataGridTemplateColumn Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="✕" Padding="6,0" FontSize="11"
                                                                    ToolTip="Cancel this pending order"
                                                                    Command="{Binding DataContext.TerminalVm.CancelMt5OrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Ticket}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Exposure">
                                    <DataGrid ItemsSource="{Binding ExposureRows}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                              Background="Transparent" RowBackground="Transparent"
                                              BorderThickness="0" FontFamily="Consolas" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="140" />
                                            <DataGridTextColumn Header="Net volume" Binding="{Binding NetVolume, StringFormat=+0.###;-0.###;0}" Width="100" />
                                            <DataGridTextColumn Header="Open P/L" Binding="{Binding OpenProfit, StringFormat=+0.##;-0.##;0}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Account History">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox Text="{Binding HistoryFrom, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                                     Padding="4,3" ToolTip="UTC date, e.g. 2026-09-01 (empty = trailing 7 days)" />
                                            <TextBlock Text="To" VerticalAlignment="Center" Margin="8,0,4,0" />
                                            <TextBox Text="{Binding HistoryTo, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                                     Padding="4,3" ToolTip="UTC date, e.g. 2026-09-15 (empty = today)" />
                                            <Button Content="Apply" Command="{Binding ApplyHistoryRangeCommand}" Margin="8,0,0,0"
                                                    Style="{StaticResource GhostButton}" Padding="10,3" />
                                            <Button Content="⇩ Export CSV" Command="{Binding ExportHistoryCsvCommand}" Margin="6,0,0,0"
                                                    Style="{StaticResource GhostButton}" Padding="10,3" />
                                            <TextBlock Text="{Binding HistoryExportStatus}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                        <DataGrid ItemsSource="{Binding HistoryRows}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                              Background="Transparent" RowBackground="Transparent"
                                              BorderThickness="0" FontFamily="Consolas" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100" />
                                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="110" />
                                            <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="60" />
                                            <DataGridTextColumn Header="Vol" Binding="{Binding Volume, StringFormat=0.###}" Width="60" />
                                            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="80" />
                                            <DataGridTextColumn Header="P/L" Binding="{Binding Profit, StringFormat=+0.##;-0.##;0}" Width="80" />
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                                        </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Journal">
                                    <DataGrid ItemsSource="{Binding JournalRows}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                              Background="Transparent" RowBackground="Transparent"
                                              BorderThickness="0" FontFamily="Consolas" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="100" />
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
                                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Border>

                        <!-- Middle: market watch | ladder+chart | ticket/MT5 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Market watch -->
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="MARKET WATCH" Style="{StaticResource SectionTitle}"
                                                   DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <Button Content="⟳" Command="{Binding LoadSymbolsCommand}" DockPanel.Dock="Right"
                                                HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                                Padding="10,4" />
                                    </DockPanel>
                                    <TextBox Grid.Row="1" Text="{Binding SymbolFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4,3" Margin="0,0,0,6"
                                             ToolTip="Type to filter the symbol list" />
                                    <DataGrid Grid.Row="2"
                                              ItemsSource="{Binding FilteredSymbols}"
                                              SelectedItem="{Binding SelectedSymbol}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                              Background="Transparent" RowBackground="Transparent"
                                              BorderThickness="0" FontFamily="Consolas"
                                              VirtualizingPanel.IsVirtualizing="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="110" />
                                            <DataGridTextColumn Header="Bid" Binding="{Binding Bid, StringFormat=0.#####}" Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        <Setter Property="TextAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Ask" Binding="{Binding Ask, StringFormat=0.#####}" Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="TextAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Spr" Binding="{Binding Spread, StringFormat=0.#####}" Width="70" />
                                            <DataGridTextColumn Header="State" Binding="{Binding OpenText}" Width="64" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- Ladder + chart -->
                            <Grid Grid.Column="2" Width="190">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="MARKET DEPTH" Style="{StaticResource SectionTitle}" FontSize="11" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Ladder}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <TextBlock Text="{Binding Price, StringFormat=0.#####}" FontFamily="Consolas" FontSize="11"
                                                                   HorizontalAlignment="Left">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Side}" Value="ask">
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Side}" Value="bid">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Size}" FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding OhlcText}" FontFamily="Consolas" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Candles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="6" Height="120" VerticalAlignment="Bottom">
                                                        <Rectangle Height="{Binding BarHeight}" VerticalAlignment="Bottom"
                                                                   Margin="0,0,0,6">
                                                            <Rectangle.Style>
                                                                <Style TargetType="Rectangle">
                                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Up}" Value="False">
                                                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Rectangle.Style>
                                                        </Rectangle>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Ticket + MT5 card -->
                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- MT5 order card -->
                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="MT5 ORDER (CFD/FOREX)" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding Mt5StatusText}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </DockPanel>
                                        <UniformGrid Columns="4">
                                            <ComboBox Margin="0,0,6,6" ItemsSource="{Binding Mt5Actions}"
                                                      SelectedItem="{Binding Mt5Action}" />
                                            <ComboBox Margin="0,0,6,6" ItemsSource="{Binding Mt5Types}"
                                                      SelectedItem="{Binding Mt5Type}" />
                                            <TextBox Margin="0,0,6,6" ToolTip="Symbol"
                                                     Text="{Binding Mt5Symbol, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" />
                                            <TextBox Margin="0,0,0,6" ToolTip="Lots"
                                                     Text="{Binding Mt5Lots, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Padding="4,3" />
                                            <TextBox Margin="0,0,6,0" ToolTip="Price (limit/stop)"
                                                     Visibility="{Binding Mt5PriceVisibility}"
                                                     Text="{Binding Mt5Price, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Padding="4,3" />
                                            <TextBox Margin="0,0,6,0" ToolTip="Stop trigger (stop-limit)"
                                                     Visibility="{Binding Mt5StopPriceVisibility}"
                                                     Text="{Binding Mt5StopPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Padding="4,3" />
                                            <TextBox Margin="0,0,6,0" ToolTip="Stop loss (optional)"
                                                     Text="{Binding Mt5Sl, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Padding="4,3" />
                                            <TextBox Margin="0,0,0,0" ToolTip="Take profit (optional)"
                                                     Text="{Binding Mt5Tp, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Padding="4,3" />
                                        </UniformGrid>
                                        <Button Content="SEND MT5 ORDER" Command="{Binding PlaceMt5OrderCommand}"
                                                Margin="0,10,0,4" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Mt5OrderStatus}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding TicketStatus}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding BrainStateText}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Journal">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Controls -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="TRADE JOURNAL" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Complete log of all brain decisions, trade executions, and account activity." Foreground="{StaticResource TextSecondaryBrush}" />
                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Width="150" Margin="0,0,10,0">
                                    <TextBlock Text="Filter category" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding JournalVm.Categories}" SelectedItem="{Binding JournalVm.FilterCategory}" />
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,0">
                                    <TextBlock Text="Max entries" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding JournalVm.MaxEntries, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,10,0">
                                    <TextBlock Text="From date" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding JournalVm.FilterDateFrom}" />
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,10,0">
                                    <TextBlock Text="To date" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding JournalVm.FilterDateTo}" />
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,10,0">
                                    <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding JournalVm.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Refresh" Command="{Binding JournalVm.RefreshCommand}" />
                                <Button Content="Clear filter" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding JournalVm.ClearFilterCommand}" />
                                <Button Content="Export" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding JournalVm.ExportJournalCommand}" />
                                <TextBlock Text="{Binding JournalVm.StatsText}" Margin="12,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Journal entries -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding JournalVm.Entries}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Width="90" Binding="{Binding Timestamp}" />
                            <DataGridTextColumn Header="Account" Width="80" Binding="{Binding AccountId}" />
                            <DataGridTextColumn Header="Category" Width="120" Binding="{Binding Category}" />
                            <DataGridTextColumn Header="Details" Width="*" Binding="{Binding Details}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Performance">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Summary -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE DASHBOARD" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding PerformanceVm.SummaryText}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{Binding PerformanceVm.TelemetrySummaryText}" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       ToolTip="Live cycle telemetry (latency/errors) collected by the growth runners and the Brain tab loop; refreshes every 3 seconds" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Refresh" Command="{Binding PerformanceVm.RefreshCommand}" />
                                <Button Content="Export CSV" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding PerformanceVm.ExportToCsvCommand}" />
                                <Button Content="Export metrics" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding PerformanceVm.ExportMetricsCommand}"
                                        ToolTip="Write per-account operational metrics (trades, wins, P&amp;L) to tf_metrics_*.csv and .json in Documents" />
                                <TextBlock Text="{Binding PerformanceVm.StatusMessage}" Margin="12,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Account Stats -->
                    <TextBlock Grid.Row="1" Text="ACCOUNT STATS" Style="{StaticResource SectionTitle}" Margin="4,0,0,6" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding PerformanceVm.AccountStats}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Width="120" Binding="{Binding AccountName}" />
                            <DataGridTextColumn Header="Trades" Width="70" Binding="{Binding TotalTrades}" />
                            <DataGridTextColumn Header="Wins" Width="60" Binding="{Binding Wins}" />
                            <DataGridTextColumn Header="Losses" Width="60" Binding="{Binding Losses}" />
                            <DataGridTextColumn Header="Win Rate" Width="80" Binding="{Binding WinRate, StringFormat=P0}" />
                            <DataGridTextColumn Header="P&amp;L" Width="90" Binding="{Binding TotalProfit, StringFormat=+0.##;-0.##;0}" />
                            <DataGridTextColumn Header="ROI" Width="70" Binding="{Binding ROI, StringFormat=P1}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Strategy Stats -->
                    <TextBlock Grid.Row="3" Text="STRATEGY STATS" Style="{StaticResource SectionTitle}" Margin="4,0,0,6" />
                    <DataGrid Grid.Row="4" ItemsSource="{Binding PerformanceVm.StrategyStats}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Strategy" Width="120" Binding="{Binding Strategy}" />
                            <DataGridTextColumn Header="Trades" Width="70" Binding="{Binding TotalTrades}" />
                            <DataGridTextColumn Header="Wins" Width="60" Binding="{Binding Wins}" />
                            <DataGridTextColumn Header="Losses" Width="60" Binding="{Binding Losses}" />
                            <DataGridTextColumn Header="Win Rate" Width="80" Binding="{Binding WinRate, StringFormat=P0}" />
                            <DataGridTextColumn Header="P&amp;L" Width="90" Binding="{Binding TotalProfit, StringFormat=+0.##;-0.##;0}" />
                            <DataGridTextColumn Header="ROI" Width="70" Binding="{Binding ROI, StringFormat=P1}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Strategy comparison summary -->
                    <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0"
                            Visibility="{Binding PerformanceVm.StrategyStats.Count, Converter={StaticResource CountToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="STRATEGY COMPARISON" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Best strategy by win rate and P&amp;L:" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding PerformanceVm.StrategyComparison}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10" Margin="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Strategy}" FontWeight="Bold" />
                                                <TextBlock Grid.Column="1" Text="{Binding WinRate, StringFormat='Win: {0:P0}'}" />
                                                <TextBlock Grid.Column="2" Text="{Binding TotalTrades, StringFormat='Trades: {0}'}" />
                                                <TextBlock Grid.Column="3" Text="{Binding TotalProfit, StringFormat='P&amp;L: +0.##;-0.##;0'}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="4" Text="{Binding Rank}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Equity curve chart -->
                    <Border Grid.Row="6" Style="{StaticResource Card}" Margin="0,10,0,0"
                            Visibility="{Binding PerformanceVm.EquityCurve.Count, Converter={StaticResource CountToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="EQUITY CURVE" Style="{StaticResource SectionTitle}" />
                            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10" Height="150">
                                <Canvas x:Name="EquityCanvas" ClipToBounds="True">
                                    <Polyline Points="{Binding PerformanceVm.EquityCurvePoints}"
                                               Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                </Canvas>
                            </Border>
                            <TextBlock Text="Running P&amp;L over time" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Updates">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Controls -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="AUTO-UPDATE" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Check for and install updates automatically." Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Check for updates" Command="{Binding UpdateVm.CheckForUpdateCommand}" />
                                <Button Content="Download" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding UpdateVm.DownloadUpdateCommand}"
                                        IsEnabled="{Binding UpdateVm.AvailableUpdate, Converter={StaticResource NullToVisibility}, ConverterParameter=True}" />
                                <Button Content="Install &amp; Restart" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                        Command="{Binding UpdateVm.InstallUpdateCommand}" />
                                <Button Content="Cleanup old updates" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding UpdateVm.CleanupOldUpdatesCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10"
                            Visibility="{Binding UpdateVm.AvailableUpdate, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="UPDATE AVAILABLE" Style="{StaticResource SectionTitle}" />
                            <TextBlock>
                                <Run Text="Version: " Foreground="{StaticResource TextSecondaryBrush}" />
                                <Run Text="{Binding UpdateVm.AvailableUpdate.Version}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Size: " Foreground="{StaticResource TextSecondaryBrush}" />
                                <Run Text="{Binding UpdateVm.AvailableUpdate.FileSize}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Status log -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding UpdateVm.StatusMessage}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
