<Window x:Class="Tf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tf.App.Controls"
        xmlns:infra="clr-namespace:Tf.App.Infrastructure"
        Title="Tf — Deriv Binary-Options Trader"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="0,0,0,0">

        <!-- ═══════════ Header ═══════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TF" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="  Deriv Binary-Options Trader · LLM + Growth brains"
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dashboard.IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Dashboard.StatusText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <TextBlock Text="{Binding Dashboard.BalanceText}" FontFamily="Consolas" FontWeight="SemiBold" />
                    </Border>
                    <Button Margin="8,0,0,0" Padding="8,4"
                            ToolTip="Minimize to tray — app keeps running in background">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Content" Value="🔽 Tray" />
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Tabs ═══════════ -->
        <TabControl Margin="0,0,0,0">
            <TabItem Header="Dashboard">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />   <!-- portfolio summary -->
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Status row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel>
                            <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Symbol: " Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Dashboard.SymbolText}" FontFamily="Consolas" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Brain: " Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Brain.StatusText}" />
                                </StackPanel>
                            </Border>
                            <!-- Growth drill-down: the pill doubles as the account selector;
                                 the chosen account's session history shows in the portfolio card below. -->
                            <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0"
                                    ToolTip="Pick an account to drill into its growth sessions">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Growth: " Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Dashboard.GrowthStatus}" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding Dashboard.AccountSummaries}"
                                              SelectedItem="{Binding Dashboard.SelectedAccount}"
                                              MinWidth="110" FontSize="11"
                                              Visibility="{Binding Dashboard.HasGrowthAccounts, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusPill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Mode: " Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SettingsVm.ModeLabel}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <Button Grid.Column="1"
                                Command="{Binding Dashboard.ToggleKillSwitchCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                    <Setter Property="Content" Value="☠ KILL SWITCH" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dashboard.IsKillSwitchEngaged}" Value="True">
                                            <Setter Property="Content" Value="☠ ENGAGED — CLICK TO RESET" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Portfolio summary: combined growth P&amp;L + latched risk rails -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Portfolio P&amp;L: " Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Dashboard.CombinedGrowthPnlText}" FontFamily="Consolas" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="all growth accounts, today" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Dashboard.RiskRailAlerts}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#33FF5C5C" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Account drill-down: session history, stakes and win streak for the
                                 account picked in the Growth pill, straight from the trade store. -->
                            <TextBlock Text="{Binding Dashboard.AccountDetailsText}"
                                       Margin="0,8,0,0" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Chart -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <controls:TickChartControl x:Name="Chart"
                                                   LineBrush="{StaticResource AccentBrush}" />
                    </Border>

                    <!-- Footer -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Dashboard.LastPriceText}"
                                   FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Dashboard.TickCountText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,16" MaxWidth="720" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- 0 Account -->
                            <RowDefinition Height="Auto" />  <!-- 1 API token -->
                            <RowDefinition Height="Auto" />  <!-- 2 App ID -->
                            <RowDefinition Height="Auto" />  <!-- 3 Demo -->
                            <RowDefinition Height="Auto" />  <!-- 4 MARKET -->
                            <RowDefinition Height="Auto" />  <!-- 5 Symbol -->
                            <RowDefinition Height="Auto" />  <!-- 6 Currency -->
                            <RowDefinition Height="Auto" />  <!-- 7 Duration -->
                            <RowDefinition Height="Auto" />  <!-- 8 Stake -->
                            <RowDefinition Height="Auto" />  <!-- 9 AUTONOMY -->
                            <RowDefinition Height="Auto" />  <!-- 10 Autonomy -->
                            <RowDefinition Height="Auto" />  <!-- 11 Decision interval -->
                            <RowDefinition Height="Auto" />  <!-- 12 LLM BRAIN -->
                            <RowDefinition Height="Auto" />  <!-- 13 Base URL -->
                            <RowDefinition Height="Auto" />  <!-- 14 Model -->
                            <RowDefinition Height="Auto" />  <!-- 15 API key -->
                            <RowDefinition Height="Auto" />  <!-- 16 MARKET HOURS -->
                            <RowDefinition Height="Auto" />  <!-- 17 Respect hours -->
                            <RowDefinition Height="Auto" />  <!-- 18 Overlaps only -->
                            <RowDefinition Height="Auto" />  <!-- 19 WEBHOOKS -->
                            <RowDefinition Height="Auto" />  <!-- 20 Webhook URL -->
                            <RowDefinition Height="Auto" />  <!-- 21 Platform -->
                            <RowDefinition Height="Auto" />  <!-- 22 Events -->
                            <RowDefinition Height="Auto" />  <!-- 23 LOGGING -->
                            <RowDefinition Height="Auto" />  <!-- 24 Log level -->
                            <RowDefinition Height="Auto" />  <!-- 25 Actions -->
                            <RowDefinition Height="Auto" />  <!-- 26 Status -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="ACCOUNT" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="API token (demo)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                     infra:PasswordBoxHelper.BoundPassword="{Binding SettingsVm.ApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="App ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.AppId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Demo account" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                                  Content="Demo (real money requires explicit opt-in + risk guardrails)"
                                  IsChecked="{Binding SettingsVm.IsDemo}" />

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="MARKET" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Symbol" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.Symbol, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Currency" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.Currency, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Duration (min)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.DurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Stake" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="8" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.Stake, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="AUTONOMY" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Autonomy" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,0,0,10"
                                  Content="Let the brain place trades (guardrails enforced)"
                                  IsChecked="{Binding SettingsVm.AutonomyEnabled}" />
                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Decision interval (min)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="11" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.DecisionIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Text="LLM BRAIN" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <TextBlock Grid.Row="13" Grid.Column="0" Text="Base URL" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="13" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.LlmBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Model" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="14" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.LlmModel, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="15" Grid.Column="0" Text="API key" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="15" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.LlmApiKey, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="16" Grid.ColumnSpan="2" Text="MARKET HOURS" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <TextBlock Grid.Row="17" Grid.Column="0" Text="Respect hours" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="17" Grid.Column="1" Margin="0,0,0,10"
                                  Content="Only trade during active forex sessions"
                                  IsChecked="{Binding SettingsVm.RespectMarketHours}" />
                        <TextBlock Grid.Row="18" Grid.Column="0" Text="Overlaps only" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="18" Grid.Column="1" Margin="0,0,0,10"
                                  Content="Only trade during high-liquidity overlap windows (London/NY)"
                                  IsChecked="{Binding SettingsVm.OverlapsOnly}" />

                        <TextBlock Grid.Row="19" Grid.ColumnSpan="2" Text="WEBHOOKS" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <TextBlock Grid.Row="20" Grid.Column="0" Text="Webhook URL" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="20" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding SettingsVm.WebhookUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="21" Grid.Column="0" Text="Platform" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="21" Grid.Column="1" Margin="0,0,0,10"
                                  Content="Discord (uncheck for Slack)"
                                  IsChecked="{Binding SettingsVm.IsDiscordWebhook}" />

                        <TextBlock Grid.Row="22" Grid.Column="0" Text="Events" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="22" Grid.Column="1" Margin="0,0,0,10">
                            <CheckBox Content="Trade settlements" IsChecked="{Binding SettingsVm.WebhookOnTrade}" Margin="0,0,0,4" />
                            <CheckBox Content="Growth milestones (target/floor)" IsChecked="{Binding SettingsVm.WebhookOnMilestone}" Margin="0,0,0,4" />
                            <CheckBox Content="Circuit breaker events" IsChecked="{Binding SettingsVm.WebhookOnCircuitBreaker}" />
                        </StackPanel>

                        <TextBlock Grid.Row="23" Grid.ColumnSpan="2" Text="LOGGING" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <TextBlock Grid.Row="24" Grid.Column="0" Text="Log level" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="24" Grid.Column="1" Margin="0,0,0,10" Width="120" HorizontalAlignment="Left"
                                  ItemsSource="{Binding SettingsVm.LogLevels}" SelectedIndex="{Binding SettingsVm.LogLevel}" />

                        <StackPanel Grid.Row="25" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Save settings" Command="{Binding SettingsVm.SaveCommand}" Margin="0,0,10,0" />
                            <Button Content="Connect" Style="{StaticResource GhostButton}" Command="{Binding SettingsVm.ConnectCommand}" />
                        </StackPanel>
                        <TextBlock Grid.Row="26" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                   Text="{Binding SettingsVm.StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Accounts &amp; Growth">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- add-account card -->
                        <RowDefinition Height="Auto" />   <!-- accounts header -->
                        <RowDefinition Height="220" />    <!-- accounts grid -->
                        <RowDefinition Height="Auto" />   <!-- growth plan card -->
                        <RowDefinition Height="Auto" />   <!-- growth grid header -->
                        <RowDefinition Height="190" />    <!-- growth grid -->
                        <RowDefinition Height="Auto" />   <!-- gave-up banners -->
                        <RowDefinition Height="Auto" />   <!-- governor latch banner -->
                        <RowDefinition Height="Auto" />   <!-- governor warning banner -->
                        <RowDefinition Height="Auto" />   <!-- activity header -->
                        <RowDefinition Height="*" />      <!-- activity log -->
                        <RowDefinition Height="180" />    <!-- intraday pnl curve -->
                    </Grid.RowDefinitions>

                    <!-- ── Add account card ─────────────────────────── -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="MULTI-ACCOUNT CONNECT" Style="{StaticResource SectionTitle}" />
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Each token is its own Deriv account (one WebSocket each). Paste a demo token per row, then Connect all — every account streams its own feed and balance." />
                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Width="430" Margin="0,0,12,0">
                                    <TextBlock Text="API token (demo)" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox infra:PasswordBoxHelper.BoundPassword="{Binding AccountsVm.NewToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,12,0">
                                    <TextBlock Text="Label (optional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding AccountsVm.NewLabel, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,12,0">
                                    <TextBlock Text="Symbol" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding AccountsVm.NewSymbol, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,12,0">
                                    <TextBlock Text="Dur (min)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding AccountsVm.NewDurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,12,0">
                                    <TextBlock Text="Budget ($)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding AccountsVm.NewBudget, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,12,0">
                                    <TextBlock Text="Brain" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding AccountsVm.AvailableBrains}" SelectedItem="{Binding AccountsVm.NewBrainKey}" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="＋ Add account" Command="{Binding AccountsVm.AddAccountCommand}" />
                                <Button Content="Connect all" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding AccountsVm.ConnectAllCommand}" />
                                <Button Content="Disconnect all" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding AccountsVm.DisconnectAllCommand}" />
                                <Button Content="Export" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding AccountsVm.ExportAccountsCommand}" />
                                <Button Content="Import" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding AccountsVm.ImportAccountsCommand}" />
                                <TextBlock Text="{Binding AccountsVm.StatusMessage}" Margin="12,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Connected accounts grid ──────────────────── -->
                    <TextBlock Grid.Row="1" Text="CONNECTED ACCOUNTS" Style="{StaticResource SectionTitle}" Margin="4,0,0,6" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding AccountsVm.Accounts}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Width="140" Binding="{Binding DisplayName}" />
                            <DataGridTextColumn Header="Login" Width="110" Binding="{Binding LoginIdText}" />
                            <DataGridTextColumn Header="Status" Width="110" Binding="{Binding StatusText}" />
                            <DataGridTextColumn Header="Circuit" Width="110" Binding="{Binding CircuitStatus}" />
                            <DataGridTextColumn Header="Balance" Width="110" Binding="{Binding BalanceText}" />
                            <DataGridTextColumn Header="Symbol" Width="110" Binding="{Binding Config.Symbol}" />
                            <DataGridTextColumn Header="Mode" Width="60" Binding="{Binding Config.IsDemo}" />
                            <DataGridTextColumn Header="Brain" Width="100" Binding="{Binding Config.BrainKey}" />
                            <DataGridTemplateColumn Header="Actions" Width="*" MinWidth="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Margin="0,0,6,0" Padding="12,3"
                                                    Command="{Binding DataContext.AccountsVm.ConnectAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Content" Value="Connect" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Content" Value="Disconnect" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="Content" Value="…" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Margin="0,0,6,0" Padding="12,3"
                                                    Command="{Binding DataContext.AccountsVm.TogglePauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Content" Value="Pause" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                <Setter Property="Content" Value="Resume" />
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Margin="0,0,6,0" Padding="12,3"
                                                    Command="{Binding DataContext.AccountsVm.ResetCircuitBreakerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Content" Value="Reset" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDegraded}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Padding="12,3"
                                                    Command="{Binding DataContext.AccountsVm.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        <Setter Property="Content" Value="Remove" />
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ── Growth plan card ──────────────────────────── -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="GROWTH ENGINES — the second brain ($5 challenge)" Style="{StaticResource SectionTitle}" />
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Deterministic rules brain — no LLM or API key needed. Every connected demo account gets a session that starts at the budget below and replays today's trades, so it survives restarts. Stakes are a % of the bankroll with a ×2 recovery ladder; the session stops at the floor or daily target." />
                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Width="90" Margin="0,0,10,0">
                                    <TextBlock Text="Budget ($)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.Budget, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,0">
                                    <TextBlock Text="Risk / trade (%)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.RiskPercent, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,0">
                                    <TextBlock Text="Daily target (%)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.TargetPercent, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,0">
                                    <TextBlock Text="Stop at floor (%)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.FloorPercent, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,0">
                                    <TextBlock Text="Recovery steps" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.RecoverySteps, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,0">
                                    <TextBlock Text="Interval (min)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,0">
                                    <TextBlock Text="Failure backoff (s)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.FailureBackoffSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,0">
                                    <TextBlock Text="Max restarts" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.MaxAutoRestarts, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,0">
                                    <TextBlock Text="Restart delay (s)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.RestartBaseDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,0">
                                    <TextBlock Text="Restart ×3.0" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.RestartBackoffFactor, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,0">
                                    <TextBlock Text="Portfolio DD cap ($)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GrowthVm.PortfolioDrawdownCapText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Portfolio DD cap: stop every engine when the combined daily P&amp;L of all accounts breaches −cap (blank = off). Manual start re-arms it." />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Save plan" Style="{StaticResource GhostButton}" Command="{Binding GrowthVm.SavePlanCommand}" />
                                <Button Content="▶ Start all engines" Margin="8,0,0,0" Command="{Binding GrowthVm.StartAllCommand}" />
                                <Button Content="■ Stop all engines" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding GrowthVm.StopAllCommand}" />
                                <Border Style="{StaticResource StatusPill}" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Portfolio P&amp;L: " Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding GrowthVm.CombinedPnlText}" FontFamily="Consolas" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding GrowthVm.StatusMessage}" Margin="12,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Growth runners grid ───────────────────────── -->
                    <TextBlock Grid.Row="4" Text="RUNNERS" Style="{StaticResource SectionTitle}" Margin="4,0,0,6" />
                    <DataGrid Grid.Row="5" ItemsSource="{Binding GrowthVm.Rows}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Width="130" Binding="{Binding DisplayName}" />
                            <DataGridTextColumn Header="Login" Width="110" Binding="{Binding Connection.LoginIdText}" />
                            <DataGridTextColumn Header="Status" Width="120" Binding="{Binding Connection.StatusText}" />
                            <DataGridTextColumn Header="Balance" Width="100" Binding="{Binding Connection.BalanceText}" />
                            <DataGridTextColumn Header="Budget" Width="70" Binding="{Binding BudgetText}" />
                            <DataGridTextColumn Header="Bankroll" Width="110" Binding="{Binding Runner.BankrollText}" />
                            <DataGridTemplateColumn Header="P&amp;L today" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:PnlSparkline Points="{Binding PnlSeries}" Height="22" Margin="0,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Session" Width="150" Binding="{Binding Runner.SessionStateText}" />
                            <DataGridTemplateColumn Header="Auto-restart" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RestartText}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Button Content="↻ Restart" Margin="8,0,0,0" Padding="10,2"
                                                    Command="{Binding DataContext.GrowthVm.RestartAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Connection.Config.Id}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGaveUp}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Last activity" Width="*" Binding="{Binding Runner.LastActivity}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ── Gave-up banners (auto-restart budget exhausted) ── -->
                    <ItemsControl Grid.Row="6" ItemsSource="{Binding GrowthVm.GaveUpBanners}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#33FF5C5C" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                            <Run Text="⚠ " /><Run Text="{Binding AccountName, Mode=OneWay}" FontWeight="Bold" /><Run Text=" stopped after repeated broker failures — auto-restarts exhausted. Start it manually to try again." />
                                        </TextBlock>
                                        <Button Content="↻ Restart" Margin="10,0,0,0" Padding="12,3"
                                                Command="{Binding DataContext.GrowthVm.RestartAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding AccountId}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── Portfolio governor latch banner ────────── -->
                    <Border Grid.Row="7" Margin="0,0,0,4" CornerRadius="4" Padding="10,6"
                            Background="#33FF5C5C" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GrowthVm.IsGovernorTripped}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding GrowthVm.GovernorBannerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Content="✓ Re-arm governor" Margin="10,0,0,0" Padding="12,3"
                                    Command="{Binding GrowthVm.RearmGovernorCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- ── Portfolio governor warning banner ──────── -->
                    <Border Grid.Row="8" Margin="0,0,0,4" CornerRadius="4" Padding="10,6"
                            Background="#33FFC85C" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding GrowthVm.IsGovernorWarned}" Value="True" />
                                            <Condition Binding="{Binding GrowthVm.IsGovernorTripped}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding GrowthVm.GovernorWarningText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Border>

                    <!-- ── Activity log ──────────────────────────────── -->
                    <TextBlock Grid.Row="9" Text="ACTIVITY LOG" Style="{StaticResource SectionTitle}" Margin="4,10,0,6" />
                    <Border Grid.Row="10" Style="{StaticResource Card}" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GrowthVm.ActivityLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- ── Intraday P&amp;L curve (per account, cumulative) ───── -->
                    <TextBlock Grid.Row="11" Text="INTRADAY P&amp;L — CUMULATIVE PER ACCOUNT" Style="{StaticResource SectionTitle}" Margin="4,10,0,6" />
                    <Border Grid.Row="12" Style="{StaticResource Card}" Padding="6">
                        <controls:PnlCurveControl x:Name="PnlCurve" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Trades">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Summary + manual demo trade -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DAILY SUMMARY" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding Trades.SummaryText}" FontSize="16" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Direction:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="100" Margin="0,0,10,0"
                                          ItemsSource="{Binding Trades.Directions}"
                                          SelectedItem="{Binding Trades.SelectedDirection}" />
                                <Button Command="{Binding Trades.PlaceDemoTradeCommand}"
                                        IsEnabled="{Binding Trades.CanTrade}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Place demo trade" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Trades.IsBusy}" Value="True">
                                                    <Setter Property="Content" Value="Placing…" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Margin="4,0,0,8" TextWrapping="Wrap"
                               Text="{Binding Trades.StatusMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- Trade history -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Trades.Trades}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Acct" Width="80"
                                                Binding="{Binding AccountName, TargetNullValue=primary}" />
                            <DataGridTextColumn Header="Source" Width="70"
                                                Binding="{Binding Source, TargetNullValue=—}" />
                            <DataGridTextColumn Header="Settled" Width="80"
                                                Binding="{Binding SettledAt, StringFormat=HH:mm}" />
                            <DataGridTextColumn Header="Symbol" Width="*"
                                                Binding="{Binding Symbol}" />
                            <DataGridTextColumn Header="Direction" Width="70"
                                                Binding="{Binding Direction}" />
                            <DataGridTextColumn Header="Stake" Width="70"
                                                Binding="{Binding Stake, StringFormat=0.##}" />
                            <DataGridTextColumn Header="Outcome" Width="80"
                                                Binding="{Binding Outcome}" />
                            <DataGridTemplateColumn Header="P&amp;L" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Profit, StringFormat=+0.##;-0.##;0}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWin}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Lost">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Brain">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DECISION ENGINE" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Brain.LlmInfo}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Autonomy off: cycle decides + risk-checks only. Autonomy on: allowed trades are placed."
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Start" Style="{StaticResource {x:Type Button}}" Margin="0,0,6,0"
                                    Command="{Binding Brain.StartAutonomyCommand}" />
                            <Button Content="Stop" Style="{StaticResource {x:Type Button}}"
                                    Command="{Binding Brain.StopAutonomyCommand}" />
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding Brain.RunCycleCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Run" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Brain.IsBusy}" Value="True">
                                            <Setter Property="Content" Value="Thinking…" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Last decision card -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="LAST DECISION" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Brain.LastDecisionText}"
                                       FontFamily="Consolas" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Confidence history -->
                    <TextBlock Grid.Row="2" Text="CONFIDENCE HISTORY" Style="{StaticResource SectionTitle}" Margin="4,0,0,6" />
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,0" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Brain.ConfidenceHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Lessons -->
                    <TextBlock Grid.Row="4" Text="LESSONS / MEMORY" Style="{StaticResource SectionTitle}" Margin="4,12,0,6" />
                    <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Brain.LessonsText}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Journal">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Controls -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="TRADE JOURNAL" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Complete log of all brain decisions, trade executions, and account activity." Foreground="{StaticResource TextSecondaryBrush}" />
                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Width="150" Margin="0,0,10,0">
                                    <TextBlock Text="Filter category" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding JournalVm.Categories}" SelectedItem="{Binding JournalVm.FilterCategory}" />
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,0">
                                    <TextBlock Text="Max entries" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding JournalVm.MaxEntries, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,10,0">
                                    <TextBlock Text="From date" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding JournalVm.FilterDateFrom}" />
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,10,0">
                                    <TextBlock Text="To date" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding JournalVm.FilterDateTo}" />
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,10,0">
                                    <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding JournalVm.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Refresh" Command="{Binding JournalVm.RefreshCommand}" />
                                <Button Content="Clear filter" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding JournalVm.ClearFilterCommand}" />
                                <Button Content="Export" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding JournalVm.ExportJournalCommand}" />
                                <TextBlock Text="{Binding JournalVm.StatsText}" Margin="12,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Journal entries -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding JournalVm.Entries}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Width="90" Binding="{Binding Timestamp}" />
                            <DataGridTextColumn Header="Account" Width="80" Binding="{Binding AccountId}" />
                            <DataGridTextColumn Header="Category" Width="120" Binding="{Binding Category}" />
                            <DataGridTextColumn Header="Details" Width="*" Binding="{Binding Details}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Performance">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Summary -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE DASHBOARD" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding PerformanceVm.SummaryText}" FontSize="16" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Refresh" Command="{Binding PerformanceVm.RefreshCommand}" />
                                <Button Content="Export CSV" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding PerformanceVm.ExportToCsvCommand}" />
                                <TextBlock Text="{Binding PerformanceVm.StatusMessage}" Margin="12,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Account Stats -->
                    <TextBlock Grid.Row="1" Text="ACCOUNT STATS" Style="{StaticResource SectionTitle}" Margin="4,0,0,6" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding PerformanceVm.AccountStats}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Width="120" Binding="{Binding AccountName}" />
                            <DataGridTextColumn Header="Trades" Width="70" Binding="{Binding TotalTrades}" />
                            <DataGridTextColumn Header="Wins" Width="60" Binding="{Binding Wins}" />
                            <DataGridTextColumn Header="Losses" Width="60" Binding="{Binding Losses}" />
                            <DataGridTextColumn Header="Win Rate" Width="80" Binding="{Binding WinRate, StringFormat=P0}" />
                            <DataGridTextColumn Header="P&amp;L" Width="90" Binding="{Binding TotalProfit, StringFormat=+0.##;-0.##;0}" />
                            <DataGridTextColumn Header="ROI" Width="70" Binding="{Binding ROI, StringFormat=P1}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Strategy Stats -->
                    <TextBlock Grid.Row="3" Text="STRATEGY STATS" Style="{StaticResource SectionTitle}" Margin="4,0,0,6" />
                    <DataGrid Grid.Row="4" ItemsSource="{Binding PerformanceVm.StrategyStats}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Strategy" Width="120" Binding="{Binding Strategy}" />
                            <DataGridTextColumn Header="Trades" Width="70" Binding="{Binding TotalTrades}" />
                            <DataGridTextColumn Header="Wins" Width="60" Binding="{Binding Wins}" />
                            <DataGridTextColumn Header="Losses" Width="60" Binding="{Binding Losses}" />
                            <DataGridTextColumn Header="Win Rate" Width="80" Binding="{Binding WinRate, StringFormat=P0}" />
                            <DataGridTextColumn Header="P&amp;L" Width="90" Binding="{Binding TotalProfit, StringFormat=+0.##;-0.##;0}" />
                            <DataGridTextColumn Header="ROI" Width="70" Binding="{Binding ROI, StringFormat=P1}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Strategy comparison summary -->
                    <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0"
                            Visibility="{Binding PerformanceVm.StrategyStats.Count, Converter={StaticResource CountToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="STRATEGY COMPARISON" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Best strategy by win rate and P&amp;L:" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding PerformanceVm.StrategyComparison}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10" Margin="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Strategy}" FontWeight="Bold" />
                                                <TextBlock Grid.Column="1" Text="{Binding WinRate, StringFormat='Win: {0:P0}'}" />
                                                <TextBlock Grid.Column="2" Text="{Binding TotalTrades, StringFormat='Trades: {0}'}" />
                                                <TextBlock Grid.Column="3" Text="{Binding TotalProfit, StringFormat='P&amp;L: +0.##;-0.##;0'}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="4" Text="{Binding Rank}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Equity curve chart -->
                    <Border Grid.Row="6" Style="{StaticResource Card}" Margin="0,10,0,0"
                            Visibility="{Binding PerformanceVm.EquityCurve.Count, Converter={StaticResource CountToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="EQUITY CURVE" Style="{StaticResource SectionTitle}" />
                            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10" Height="150">
                                <Canvas x:Name="EquityCanvas" ClipToBounds="True">
                                    <Polyline Points="{Binding PerformanceVm.EquityCurvePoints}"
                                               Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                </Canvas>
                            </Border>
                            <TextBlock Text="Running P&amp;L over time" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Optimizer">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Controls -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="STRATEGY OPTIMIZER" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Backtest and optimize brain strategies on historical data." Foreground="{StaticResource TextSecondaryBrush}" />
                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Width="130" Margin="0,0,10,0">
                                    <TextBlock Text="Strategy" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding OptimizerVm.Strategies}" SelectedItem="{Binding OptimizerVm.SelectedStrategy}" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,0">
                                    <TextBlock Text="Start ($)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding OptimizerVm.StartBankroll, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,0">
                                    <TextBlock Text="Risk %" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding OptimizerVm.RiskFraction, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,0">
                                    <TextBlock Text="Max Trades" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding OptimizerVm.MaxTrades, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,0">
                                    <TextBlock Text="Iterations" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding OptimizerVm.OptimizationIterations, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="▶ Run Backtest" Command="{Binding OptimizerVm.RunBacktestCommand}" />
                                <Button Content="⚙ Run Optimization" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding OptimizerVm.RunOptimizationCommand}" />
                                <TextBlock Text="{Binding OptimizerVm.StatusMessage}" Margin="12,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Last result -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10"
                            Visibility="{Binding OptimizerVm.LastResult, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="LAST BACKTEST RESULT" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Strategy" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding OptimizerVm.LastResult.Strategy}" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Trades" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding OptimizerVm.LastResult.TotalTrades}" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Win Rate" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding OptimizerVm.LastResult.WinRate, StringFormat=P0}" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="P&amp;L" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding OptimizerVm.LastResult.TotalProfit, StringFormat=+0.##;-0.##;0}" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Sharpe" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding OptimizerVm.LastResult.SharpeRatio, StringFormat=F2}" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="5">
                                    <TextBlock Text="Max DD" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding OptimizerVm.LastResult.MaxDrawdown, StringFormat=0.##}" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Optimization results -->
                    <TextBlock Grid.Row="2" Text="TOP OPTIMIZATION RESULTS" Style="{StaticResource SectionTitle}" Margin="4,0,0,6"
                               Visibility="{Binding OptimizerVm.Results.Count, Converter={StaticResource CountToVisibility}}" />
                    <DataGrid Grid.Row="3" ItemsSource="{Binding OptimizerVm.Results}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameters" Width="*" Binding="{Binding Parameters}" />
                            <DataGridTextColumn Header="P&amp;L" Width="90" Binding="{Binding TotalProfit, StringFormat=+0.##;-0.##;0}" />
                            <DataGridTextColumn Header="Sharpe" Width="80" Binding="{Binding SharpeRatio, StringFormat=F2}" />
                            <DataGridTextColumn Header="Max DD" Width="80" Binding="{Binding MaxDrawdown, StringFormat=0.##}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Saved results -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,6">
                        <TextBlock Text="PREVIOUS RUNS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Content="Load" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                                Command="{Binding OptimizerVm.LoadSavedResultsCommand}" />
                    </StackPanel>
                    <DataGrid Grid.Row="5" ItemsSource="{Binding OptimizerVm.SavedResults}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True"
                              Visibility="{Binding OptimizerVm.SavedResults.Count, Converter={StaticResource CountToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Strategy" Width="120" Binding="{Binding Strategy}" />
                            <DataGridTextColumn Header="Sharpe" Width="80" Binding="{Binding BestSharpe, StringFormat=F2}" />
                            <DataGridTextColumn Header="P&amp;L" Width="90" Binding="{Binding BestPnl, StringFormat=+0.##;-0.##;0}" />
                            <DataGridTextColumn Header="Iterations" Width="80" Binding="{Binding Iterations}" />
                            <DataGridTextColumn Header="Best Params" Width="*" Binding="{Binding BestParams}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Updates">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Controls -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="AUTO-UPDATE" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Check for and install updates automatically." Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Check for updates" Command="{Binding UpdateVm.CheckForUpdateCommand}" />
                                <Button Content="Download" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding UpdateVm.DownloadUpdateCommand}"
                                        IsEnabled="{Binding UpdateVm.AvailableUpdate, Converter={StaticResource NullToVisibility}, ConverterParameter=True}" />
                                <Button Content="Install &amp; Restart" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                        Command="{Binding UpdateVm.InstallUpdateCommand}" />
                                <Button Content="Cleanup old updates" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding UpdateVm.CleanupOldUpdatesCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10"
                            Visibility="{Binding UpdateVm.AvailableUpdate, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="UPDATE AVAILABLE" Style="{StaticResource SectionTitle}" />
                            <TextBlock>
                                <Run Text="Version: " Foreground="{StaticResource TextSecondaryBrush}" />
                                <Run Text="{Binding UpdateVm.AvailableUpdate.Version}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Size: " Foreground="{StaticResource TextSecondaryBrush}" />
                                <Run Text="{Binding UpdateVm.AvailableUpdate.FileSize}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Status log -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding UpdateVm.StatusMessage}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Health">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Summary -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="SYSTEM HEALTH" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding HealthVm.OverallStatus}" FontSize="16" FontWeight="Bold" />
                            <WrapPanel Margin="0,8,0,0">
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Connected: " Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding HealthVm.ConnectedCount}" FontWeight="Bold" />
                                        <TextBlock Text="/{Binding HealthVm.TotalAccounts}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Engines: " Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding HealthVm.RunningEngines}" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Degraded: " Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding HealthVm.DegradedCount}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Paused: " Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding HealthVm.PausedCount}" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusPill}">
                                    <TextBlock Text="{Binding HealthVm.CacheStats}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Refresh" Command="{Binding HealthVm.RefreshCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Per-account health -->
                    <TextBlock Grid.Row="1" Text="ACCOUNT HEALTH" Style="{StaticResource SectionTitle}" Margin="4,0,0,6" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding HealthVm.Accounts}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Width="120" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Login" Width="90" Binding="{Binding LoginId}" />
                            <DataGridTextColumn Header="Symbol" Width="100" Binding="{Binding Symbol}" />
                            <DataGridTextColumn Header="Brain" Width="100" Binding="{Binding Brain}" />
                            <DataGridTextColumn Header="Status" Width="130" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Balance" Width="100" Binding="{Binding Balance}" />
                            <DataGridTextColumn Header="Ticks" Width="80" Binding="{Binding TickBuffer}" />
                            <DataGridTextColumn Header="Cached" Width="90" Binding="{Binding CachedTicks}" />
                            <DataGridTextColumn Header="Engine" Width="60" Binding="{Binding HasRunner, Converter={StaticResource NullToVisibility}}" />
                            <DataGridTextColumn Header="Circuit" Width="130" Binding="{Binding CircuitStatus}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>