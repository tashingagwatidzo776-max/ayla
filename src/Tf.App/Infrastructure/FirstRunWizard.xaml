<Window x:Class="Tf.App.Infrastructure.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Tf.App.Infrastructure"
        Title="Tf — First Run Setup"
        Width="520" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF14161A">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Welcome to Tf" FontSize="24" FontWeight="Bold"
                   Foreground="#FF00D4AA" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="Set up your Deriv demo account to start trading."
                   FontSize="14" Foreground="#FF9AA3B2" Margin="0,0,0,16" />

        <!-- Form -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="API Token (demo)" Foreground="#FF9AA3B2" Margin="0,0,0,4" />
                <PasswordBox x:Name="TokenBox" Margin="0,0,0,12"
                             infra:PasswordBoxHelper.BoundPassword="{Binding ApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Symbol" Foreground="#FF9AA3B2" Margin="0,0,0,4" />
                <TextBox x:Name="SymbolBox" Text="frxEURUSD" Margin="0,0,0,12" />

                <TextBlock Text="Trading Brain" Foreground="#FF9AA3B2" Margin="0,0,0,4" />
                <ComboBox x:Name="BrainCombo" Margin="0,0,0,12" SelectedIndex="0">
                    <ComboBoxItem Content="Growth — deterministic $5 challenge (Recommended)" />
                    <ComboBoxItem Content="Trend Following — EMA crossover + ADX" />
                    <ComboBoxItem Content="Breakout — Bollinger Bands + ATR" />
                    <ComboBoxItem Content="Mean Reversion — RSI + Z-score" />
                </ComboBox>

                <TextBlock Text="Daily Budget ($)" Foreground="#FF9AA3B2" Margin="0,0,0,4" />
                <TextBox x:Name="BudgetBox" Text="5.00" Margin="0,0,0,12" />

                <CheckBox x:Name="AutonomyCheck" Content="Enable autonomy (brain places trades automatically)"
                          IsChecked="False" Margin="0,0,0,8" />
                <TextBlock Text="⚠ Autonomy lets the brain place real trades. Start with demo only."
                           Foreground="#FFFFC857" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                <CheckBox x:Name="MarketHoursCheck" Content="Respect market hours (only trade during active sessions)"
                          IsChecked="True" />
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Skip for now" Padding="16,8" Margin="0,0,8,0"
                    Background="Transparent" Foreground="#FFE8EAF0" BorderBrush="#FF2E3440"
                    Click="OnSkip" />
            <Button Content="Save &amp; Connect" Padding="16,8"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
