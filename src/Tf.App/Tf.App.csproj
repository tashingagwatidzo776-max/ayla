<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Tf.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tf.Core\Tf.Core.csproj" />
    <ProjectReference Include="..\Tf.Deriv\Tf.Deriv.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Tf</AssemblyName>
    <Product>Tf — Deriv options trader</Product>
    <!-- Dev fallback. Publish stamps the real identity: scripts/publish_exe.ps1
         and the tag workflow pass -p:InformationalVersion="<tag>+<commit>" (CLI
         properties override the generated one), which the window title and
         About box read at runtime so shipped binaries identify themselves. -->
    <Version>0.7.0</Version>
  </PropertyGroup>

</Project>
